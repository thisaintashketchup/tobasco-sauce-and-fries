from machine import Pin, PWM
import time
import random
import neopixel

np = neopixel.NeoPixel(Pin(23), 16)
switch1 = Pin(18, Pin.IN, Pin.PULL_UP)  # Red
switch2 = Pin(4, Pin.IN, Pin.PULL_UP)  # Blue

pressed1 = 0
pressed2 = 0
hits = [False] * 16

tail=PWM(Pin(21, Pin.OUT))
ledblue = Pin(27,Pin.OUT)
ledred = Pin(14, Pin.OUT)
tail.freq(50)


while True:
    ledred.off()
    ledblue.off()
    for i in range(16):
        if not hits[i]:
            np[i] = (0, 0, 0)
    np.write()
    
    
    free = [i for i in range(16) if not hits[i]]
    if not free:
        time.sleep(1)
        pressed1 = 0
        pressed2 = 0
        hits = [False] * 16
        continue
    
    lightup = random.choice(free)
    np[lightup] = (10, 10, 10)  
    np.write()
    #debounc
    start = time.ticks_ms()
    while True:
        if switch1.value() == 0 and not hits[lightup]:
            np[lightup] = (20, 3, 1)  # Red hit
            hits[lightup] = True
            pressed1 += 1
            np.write()
            print ("red: pressed1")
            time.sleep(0.2) 
            break
        if switch2.value() == 0 and not hits[lightup]:
            np[lightup] = (1, 3, 20)  # Blue hit
            hits[lightup] = True
            pressed2 += 1
            print ("blue: pressed2")
            np.write()
            time.sleep(0.2) 
            break
            time.sleep(0.2) 

    if pressed1 == 9 or pressed2 == 9:
        if pressed1 > pressed2:
            ledred.on()
            for i in range (0,3,1):
                for i in range(25,123,5):
                    tail.duty(i)
                    time.sleep(0.02)
        elif pressed2 > pressed1:
            ledblue.on()
            time.sleep(0.2)
            for i in range (0,3,1):
                for i in range(25,123,5):
                    tail.duty(i)
                    time.sleep(0.02)        

